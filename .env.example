# ==============================================================================
# NutriTrack AI — Root Environment Configuration Template (.env.example)
# Copy this file to '.env' at the repository root and customize for your environment:
#   cp .env.example .env
#
# DO NOT commit real secrets or the '.env' file to source control.
# ==============================================================================

# PostgreSQL Credentials (used by Docker Compose for postgres service and backend)
POSTGRES_DB=nutritrack
POSTGRES_USER=nutritrack
POSTGRES_PASSWORD=replace_with_a_strong_unique_password

# JWT Signing Secret (must be cryptographically random and at least 32 bytes)
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# Frontend Build-time / Target API URL
VITE_API_BASE_URL=http://localhost:8081

# Allowed CORS Origins (comma-separated, without trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
