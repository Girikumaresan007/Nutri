{
  "name": "NutriTrack AI",
  "short_name": "NutriTrack",
  "description": "NutriTrack AI — a calm, intelligent companion for everyday nutrition, food diary logging, AI meal scanning, and workout tracking.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "portrait-primary",
  "background_color": "#f8f6ef",
  "theme_color": "#244C3A",
  "categories": ["health", "fitness", "lifestyle", "food"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/nutritrack-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Food Diary",
      "short_name": "Diary",
      "description": "View and log your daily meals",
      "url": "/diary",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI Food Scanner",
      "short_name": "Scan",
      "description": "Scan and analyze meal photos with AI",
      "url": "/scanner",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Workout Tracker",
      "short_name": "Workouts",
      "description": "Track exercises and training sessions",
      "url": "/workouts",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
