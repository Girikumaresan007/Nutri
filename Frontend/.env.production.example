# Production Frontend Configuration (.env.production.example)
#
# Replace with your deployed Spring Boot API domain (HTTPS required in production).
# Example: https://api.nutritrack.example.com or https://nutritrack-backend.onrender.com
#
# NOTE: If using Vercel API rewrites, leave VITE_API_BASE_URL empty so requests route through the same origin.
VITE_API_BASE_URL=https://api.yourdomain.com
