# NutriTrack Frontend Environment Configuration (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# In Vite, any variable prefixed with `VITE_` is statically embedded into the client-side
# JavaScript bundle during `npm run build`. They are visible to anyone inspecting the site.
# NEVER place database credentials, JWT secrets, or backend private keys here.

# Target Backend API URL (without trailing slash)
# For local development:
VITE_API_BASE_URL=http://localhost:8081

# For cloud production deployments (e.g., Render, Railway, AWS):
# VITE_API_BASE_URL=https://nutritrack-backend.onrender.com
#
# If deploying on Vercel with path rewrites (recommended for zero-cookie-friction):
# Leave blank to use relative paths (same origin):
# VITE_API_BASE_URL=