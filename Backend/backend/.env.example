# NutriTrack Backend Environment Template (.env.example)
# Copy to your secret store or .env; NEVER commit production secrets to Git.

SPRING_PROFILES_ACTIVE=prod            # dev | prod
PORT=8080                              # Injected dynamically on Render/Railway/Heroku/Fly.io

# PostgreSQL Configuration
DB_URL=jdbc:postgresql://your-db-host.internal:5432/nutritrack
DB_USERNAME=nutritrack_user
DB_PASSWORD=your_strong_random_database_password
DB_POOL_MAX_SIZE=10                    # Kept <= 10 for cloud free tiers (e.g., Neon/Supabase)
DB_POOL_MIN_IDLE=2

# JWT Secret (Mandatory in prod: random string >= 48 characters)
# Generate via: openssl rand -base64 48
JWT_SECRET=replace_with_48_character_cryptographically_secure_random_key_here
JWT_ACCESS_TTL=15m

# Refresh Token & Cookie Configuration
REFRESH_TOKEN_TTL=14d
REFRESH_COOKIE_SECURE=true             # Must be true in HTTPS production
REFRESH_COOKIE_SAMESITE=Strict         # Use 'Strict' or 'Lax' for same apex domain; 'None' if split domains
REFRESH_COOKIE_DOMAIN=                 # e.g., .yourdomain.com (leave blank for host-only)

# CORS: Explicit allowed frontend origins (comma-separated, HTTPS required in prod)
CORS_ALLOWED_ORIGINS=https://nutritrack.yourdomain.com,https://your-frontend.vercel.app

# Vision AI Scanner Provider
SCANNER_PROVIDER=huggingface           # none | huggingface | anthropic (mock is dev-only)

# Local or Deployed Hugging Face / ViT Inference Service
# When running in Docker Compose, use http://python-inference:5001/classify
# When running on internal container networks (e.g., Railway/Render), use internal DNS
HF_INFERENCE_ENDPOINT=http://python-inference:5001/classify
HF_TOKEN=                              # Optional HF user access token
HF_TIMEOUT=15s
HF_MIN_CONFIDENCE=0.25

# Optional Anthropic Claude Vision Fallback (Alternative)
AI_ENDPOINT=https://api.anthropic.com
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1500
AI_TIMEOUT=45s

# Upload limits
SCANNER_MAX_FILE_SIZE=10MB
SCANNER_MAX_REQUEST_SIZE=11MB

# Rate Limiting (In-memory, sliding-window per JVM instance)
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW=15m
RATE_LIMIT_SCANNER_REQUESTS=20
RATE_LIMIT_SCANNER_WINDOW=1m
